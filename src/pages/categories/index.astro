---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const categoryMap = new Map<string, typeof allPosts>();

allPosts.forEach((post) => {
  post.data.categories.forEach((category: string) => {
    if (!categoryMap.has(category)) categoryMap.set(category, []);
    categoryMap.get(category)!.push(post);
  });
});

const categories = [...categoryMap.entries()]
  .map(([name, posts]) => ({
    name,
    posts,
    count: posts.length,
    latest: posts.sort(
      (a, b) => b.data.date.getTime() - a.data.date.getTime()
    )[0],
  }))
  .sort((a, b) => b.count - a.count);
---

<BaseLayout title="Categories">
  <main class="mx-auto max-w-6xl px-4 py-12">
    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-[var(--accent)]">
        Explore Discover Bhubaneswar
      </p>
      <h1 class="hero-weight text-4xl sm:text-5xl mb-4">Categories</h1>
      <p class="max-w-2xl text-lg text-[var(--ink-soft)]">
        Browse stories, guides and local discoveries by topic.
      </p>
    </header>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {categories.map(({ name, count, latest }) => (
        <a
          href={`/categories/${name}/`}
          class="group flex flex-col rounded-2xl border border-[var(--line)] bg-[var(--surface)] p-6 transition hover:-translate-y-1 hover:border-[var(--accent)]"
        >
          <div class="mb-5 flex items-center justify-between gap-3">
            <span class="text-sm text-[var(--ink-soft)]">
              {count} {count === 1 ? 'article' : 'articles'}
            </span>
            <span class="text-xl text-[var(--accent)] transition group-hover:translate-x-1">→</span>
          </div>

          <h2 class="mb-3 text-2xl font-semibold">{name}</h2>

          {latest && (
            <div class="mt-auto border-t border-[var(--line)] pt-4">
              <p class="mb-1 text-xs uppercase tracking-wide text-[var(--ink-soft)]">
                Latest story
              </p>
              <p class="text-sm font-medium">{latest.data.title}</p>
            </div>
          )}
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
