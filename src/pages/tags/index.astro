---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const tagMap = new Map<string, number>();

allPosts.forEach((post) => {
  post.data.tags.forEach((tag: string) => {
    tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
  });
});

const tags = [...tagMap.entries()].sort((a, b) => b[1] - a[1]);
const popularTags = tags.slice(0, 12);
const alphabeticalTags = [...tags].sort((a, b) => a[0].localeCompare(b[0]));

const groupedTags = new Map<string, typeof alphabeticalTags>();
alphabeticalTags.forEach((tag) => {
  const letter = tag[0].toUpperCase();
  if (!groupedTags.has(letter)) groupedTags.set(letter, []);
  groupedTags.get(letter)!.push(tag);
});
---

<BaseLayout title="Tags">
  <main class="mx-auto max-w-6xl px-4 py-12">
    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-[var(--accent)]">
        Find something interesting
      </p>
      <h1 class="hero-weight text-4xl sm:text-5xl mb-4">Tags</h1>
      <p class="max-w-2xl text-lg text-[var(--ink-soft)]">
        Explore articles by places, interests and subjects.
      </p>
    </header>

    <section class="mb-12">
      <h2 class="mb-5 text-2xl font-semibold">Popular tags</h2>
      <div class="flex flex-wrap gap-3">
        {popularTags.map(([tag, count]) => (
          <a
            href={`/tags/${tag}/`}
            class="tag-pill !text-sm !px-4 !py-2"
          >
            {tag} <span class="ml-1 opacity-60">{count}</span>
          </a>
        ))}
      </div>
    </section>

    <section>
      <h2 class="mb-6 text-2xl font-semibold">Browse all tags</h2>

      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {[...groupedTags.entries()].map(([letter, items]) => (
          <div class="border-t border-[var(--line)] pt-4">
            <h3 class="mb-4 text-xl font-semibold text-[var(--accent)]">{letter}</h3>
            <ul class="space-y-3">
              {items.map(([tag, count]) => (
                <li>
                  <a
                    href={`/tags/${tag}/`}
                    class="flex items-center justify-between gap-3 text-sm transition hover:text-[var(--accent)]"
                  >
                    <span>{tag}</span>
                    <span class="text-[var(--ink-soft)]">{count}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
