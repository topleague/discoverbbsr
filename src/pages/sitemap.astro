---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => !data.draft);

const sortedPosts = [...posts].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const categories = [
  ...new Set(posts.flatMap((post) => post.data.categories)),
].sort((a, b) => a.localeCompare(b));

const tags = [
  ...new Set(posts.flatMap((post) => post.data.tags)),
].sort((a, b) => a.localeCompare(b));
---

<BaseLayout
  title="Sitemap"
  description="Browse all articles, categories and tags on Discover Bhubaneswar."
>
  <main class="mx-auto max-w-6xl px-4 py-12">
    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-[var(--accent)]">
        Explore Discover Bhubaneswar
      </p>
      <h1 class="hero-weight mb-4 text-4xl sm:text-5xl">Sitemap</h1>
      <p class="max-w-2xl text-lg text-[var(--ink-soft)]">
        Browse our stories, places, people and discoveries from Bhubaneswar and Odisha.
      </p>
    </header>

    <div class="grid gap-12 lg:grid-cols-2">
      <section>
        <h2 class="mb-5 text-2xl font-semibold">Pages</h2>
        <ul class="space-y-3">
          <li><a href="/" class="hover:text-[var(--accent)]">Home</a></li>
          <li><a href="/about/" class="hover:text-[var(--accent)]">About</a></li>
          <li><a href="/categories/" class="hover:text-[var(--accent)]">All categories</a></li>
          <li><a href="/tags/" class="hover:text-[var(--accent)]">All tags</a></li>
        </ul>
      </section>

      <section>
        <h2 class="mb-5 text-2xl font-semibold">Categories</h2>
        <ul class="grid gap-3 sm:grid-cols-2">
          {categories.map((category) => (
            <li>
              <a
                href={`/categories/${category}/`}
                class="hover:text-[var(--accent)]"
              >
                {category}
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="mb-5 text-2xl font-semibold">Tags</h2>
        <ul class="grid gap-3 sm:grid-cols-2">
          {tags.map((tag) => (
            <li>
              <a
                href={`/tags/${tag}/`}
                class="hover:text-[var(--accent)]"
              >
                {tag}
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="mb-5 text-2xl font-semibold">
          Articles <span class="text-sm font-normal text-[var(--ink-soft)]">({sortedPosts.length})</span>
        </h2>
        <ul class="space-y-3">
          {sortedPosts.map((post) => (
            <li>
              <a
                href={`/${post.id}/`}
                class="hover:text-[var(--accent)]"
              >
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </main>
</BaseLayout>
