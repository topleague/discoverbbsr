---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostGridCard from '@/components/PostGridCard.astro';
import Pagination from '@/components/Pagination.astro';
import Sidebar from '@/components/Sidebar.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const posts = allPosts.slice(0, 9);
const lastPage = Math.ceil(allPosts.length / 9);

const tagCounts = new Map<string, number>();
allPosts.forEach(p => p.data.tags.forEach((t: string) => tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1)));
const topTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);
---
<BaseLayout>
  <section class="mb-12">
    <h1 class="hero-weight text-4xl sm:text-5xl mb-3">Discover Bhubaneswar</h1>
    <p class="text-[var(--ink-soft)] max-w-xl">Stories, people, places and culture from Bhubaneswar and Odisha.</p>
  </section>
  <div class="grid lg:grid-cols-[1fr_300px] gap-12">
    <div>
      <div class="grid sm:grid-cols-2 gap-6">
        {posts.map(post => <PostGridCard post={post} />)}
      </div>
      <Pagination currentPage={1} lastPage={lastPage} />
    </div>
    <Sidebar tags={topTags} />
  </div>
</BaseLayout>
