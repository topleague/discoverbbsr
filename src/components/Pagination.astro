---
const { currentPage, lastPage, basePath = '/' } = Astro.props;

const pageUrl = (number: number) => {
  if (number === 1) return basePath;
  return basePath === '/'
    ? `/page/${number}/`
    : `${basePath}page/${number}/`;
};
---
{lastPage > 1 && (
  <nav class="flex items-center justify-between gap-4 mt-10 pt-6 border-t" style="border-color: var(--line)" aria-label="Pagination">
    {currentPage > 1
      ? <a href={pageUrl(currentPage - 1)} class="text-[var(--accent)]">← Previous</a>
      : <span />}
    <span class="text-sm text-[var(--ink-soft)]">Page {currentPage} of {lastPage}</span>
    {currentPage < lastPage
      ? <a href={pageUrl(currentPage + 1)} class="text-[var(--accent)]">Next →</a>
      : <span />}
  </nav>
)}
